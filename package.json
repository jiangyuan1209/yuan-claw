{
  "name": "@jiangyuan1209/yuan-claw",
  "version": "0.1.19",
  "description": "A local CLI agent with tools, search, and interactive approval.",
  "type": "module",
  "bin": {
    "yuan-claw": "dist/cli/main.js",
    "yuan-claw-web": "dist/web/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangyuan1209/yuan-claw.git"
  },
  "files": [
    "dist",
    "web-dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli/main.ts",
    "dev:web": "tsx src/web/server.ts",
    "dev:web:ui": "cd src/web/app && vite",
    "build": "tsc -p tsconfig.json",
    "build:web:ui": "cd src/web/app && vite build",
    "start": "node dist/cli/main.js",
    "start:web": "node dist/web/server.js",
    "check": "tsc --noEmit",
    "publish:npm": "./publish-npm.sh",
    "publish:gh": "./publish-gh.sh",
    "link:global": "npm run build && npm link",
    "unlink:global": "npm unlink @jiangyuan1209/yuan-claw",
    "uninstall:local": "npm uninstall -g @jiangyuan1209/yuan-claw",
    "install:local": "npm run build && npm install -g ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/x": "^2.9.0",
    "@clack/prompts": "^1.3.0",
    "@mozilla/readability": "^0.6.0",
    "antd": "^6.6.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.0.2",
    "openai": "^4.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.7.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.2.2"
  }
}
